      `).join("");
    }

    /* ========================================================================
       STUDENT DASHBOARD RENDERING & ACTIONS (STRICTLY ISOLATED)
       ======================================================================== */
    function renderStudentDashboard() {
      // Refresh student object from state
      const stu = appState.students.find(s => s.enrollment === currentSession.user.enrollment);
      if (!stu) return;
      currentSession.user = stu;

      document.getElementById("studentProfileName").textContent = stu.name;
      document.getElementById("studentProfileSem").textContent = stu.semester;
      document.getElementById("studentProfileEnroll").textContent = stu.enrollment;

      // Render Profile Avatar
      const avatarBox = document.getElementById("studentAvatarContainer");
      const removePicBtn = document.getElementById("removePicBtn");
      if (stu.avatar) {
        avatarBox.innerHTML = `<img src="${stu.avatar}" alt="Student Avatar" />`;
        removePicBtn.classList.remove("hidden");
      } else {
        const initials = stu.name.split(" ").map(n => n[0]).join("").slice(0, 2).toUpperCase();
        avatarBox.innerHTML = `<span>${escapeHtml(initials)}</span>`;
        removePicBtn.classList.add("hidden");
      }

      // Render Overall Percentage Summary
      const avg = getStudentAverages(stu.enrollment);
      document.getElementById("studentSummaryBox").innerHTML = `
        <div style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 600;">Overall Aggregate</div>
        <div style="font-size: 1.65rem; font-weight: 800; color: var(--student-color);">${avg.finalPct}</div>
        <span class="badge ${avg.passed ? "badge-success" : "badge-warning"}">
          ${avg.passed ? "All Subjects Clear" : "Re-Mid Applicable"}
        </span>
      `;

      // Render Read-Only Marks Table
      const myMarks = appState.marks.filter(m => m.enrollment === stu.enrollment);
      const marksBody = document.getElementById("studentMarksTableBody");
      marksBody.innerHTML = myMarks.length
        ? myMarks.map(m => {
          const effective = getEffectiveScore(m);
          const passed = effective >= 12;
          return `
            <tr>
              <td><strong>${escapeHtml(m.subject)}</strong></td>
              <td>${m.mid} / 30</td>
              <td>${m.remid !== null && m.remid !== "" ? `${m.remid} / 30` : `<span style="color: var(--text-muted);">Not Attempted</span>`}</td>
              <td><strong>${effective} / 30</strong></td>
              <td>
                <span class="badge ${passed ? "badge-success" : "badge-danger"}">
                  ${passed ? "PASS" : "RE-MID REQUIRED"}
                </span>
              </td>
            </tr>
          `;
        }).join("")
        : `<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No examination marks published yet.</td></tr>`;

      // Render Student's Own Requests
      const myReqs = appState.requests.filter(r => r.enrollment === stu.enrollment);
      document.getElementById("studentRequestsList").innerHTML = myReqs.length
        ? myReqs.map(r => `
          <div class="notice-item" style="border-left-color: ${r.status === "Resolved" ? "var(--success)" : "var(--warning)"};">
            <div class="notice-meta">
              <span>${escapeHtml(r.type)} (${escapeHtml(r.subject)})</span>
              <span class="badge ${r.status === "Resolved" ? "badge-success" : "badge-warning"}">${escapeHtml(r.status)}</span>
            </div>
            <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 0.4rem;">${escapeHtml(r.message)}</p>
            ${r.reply ? `<div style="background: var(--bg-card); padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.84rem;"><strong>Response:</strong> ${escapeHtml(r.reply)}</div>` : ""}
          </div>
        `).join("")
        : `<p style="color: var(--text-muted);">You haven't submitted any requests yet.</p>`;

      // Render Student's Own Feedback
      const myFb = appState.feedbacks.filter(f => f.enrollment === stu.enrollment);
      document.getElementById("studentFeedbackList").innerHTML = myFb.length
        ? myFb.map(f => `
          <div class="notice-item" style="border-left-color: var(--student-color);">
            <div class="notice-meta">
              <span>${escapeHtml(f.subject)}</span>
              <span class="badge badge-student">${escapeHtml(f.rating)}</span>
            </div>
            <p style="font-size: 0.88rem; color: var(--text-secondary);">${escapeHtml(f.comment)}</p>
          </div>
        `).join("")
        : `<p style="color: var(--text-muted);">No feedback submitted yet.</p>`;

      // Render Public / Student Notices (Strictly excluding Professors Only notices)
      const stuNotices = appState.instructions.filter(i => i.audience !== "Professors Only");
      document.getElementById("studentNoticesList").innerHTML = stuNotices.length
        ? stuNotices.map(n => `
          <div class="notice-item">
            <div class="notice-meta">
              <span class="badge badge-hod">Department Notice</span>
              <span>${escapeHtml(n.date)}</span>
            </div>
            <h4 style="font-weight: 700; margin-bottom: 0.3rem;">${escapeHtml(n.title)}</h4>
            <p style="font-size: 0.9rem; color: var(--text-secondary);">${escapeHtml(n.body)}</p>
          </div>
        `).join("")
        : `<p style="color: var(--text-muted);">No department notices available.</p>`;
    }

    // Profile Picture Upload (Base64 stored in localStorage)
    document.getElementById("profilePicUpload").addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 1.5 * 1024 * 1024) {
        showToast("Please select an image smaller than 1.5 MB.", "warning");
        return;
      }

      const reader = new FileReader();
      reader.onload = function (event) {
        const stu = appState.students.find(s => s.enrollment === currentSession.user.enrollment);
        if (stu) {
          stu.avatar = event.target.result;
          saveState();
          renderStudentDashboard();
          showToast("Profile picture updated!", "success");
        }
      };
      reader.readAsDataURL(file);
    });

    document.getElementById("removePicBtn").addEventListener("click", () => {
      const stu = appState.students.find(s => s.enrollment === currentSession.user.enrollment);
      if (stu) {
        stu.avatar = "";
        saveState();
        renderStudentDashboard();
        showToast("Profile picture removed.", "info");
      }
    });

    // Student Make a Request Form
    document.getElementById("studentRequestForm").addEventListener("submit", (e) => {
      e.preventDefault();
      const stu = currentSession.user;
      appState.requests.unshift({
        id: "REQ-" + Date.now(),
        enrollment: stu.enrollment,
        studentName: stu.name,
        type: document.getElementById("stuReqType").value,
        subject: document.getElementById("stuReqSubject").value,
        message: document.getElementById("stuReqMessage").value.trim(),
        status: "Pending",
        reply: "",
        date: new Date().toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
      });
      saveState();
      e.target.reset();
      renderStudentDashboard();
      showToast("Your request has been submitted to faculty!", "success");
    });

    // Student Give Feedback Form
    document.getElementById("studentFeedbackForm").addEventListener("submit", (e) => {
      e.preventDefault();
      const stu = currentSession.user;
      appState.feedbacks.unshift({
        id: "FB-" + Date.now(),
        enrollment: stu.enrollment,
        studentName: stu.name,
        subject: document.getElementById("stuFbSubject").value,
        rating: document.getElementById("stuFbRating").value,
        comment: document.getElementById("stuFbComment").value.trim(),
        date: new Date().toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
      });
      saveState();
      e.target.reset();
      renderStudentDashboard();
      showToast("Thank you! Your feedback has been recorded.", "success");
    });

    /* ------------------------------------------------------------------------
       SECURITY HELPER (XSS SANITIZATION)
       ------------------------------------------------------------------------ */
    function escapeHtml(str) {
      if (str === null || str === undefined) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // Boot Application
    initTheme();
  </script>
</body>
</html>
