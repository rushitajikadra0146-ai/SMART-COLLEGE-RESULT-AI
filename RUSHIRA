<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NexusUni — Academic & Department Management Portal</title>
  <style>
    /* ==========================================================================
       1. DESIGN TOKENS & THEME VARIABLES (DARK DEFAULT + LIGHT MODE)
       ========================================================================== */
    :root {
      --bg-primary: #0b0f19;
      --bg-secondary: #111827;
      --bg-card: #161f32;
      --bg-input: #1e293b;
      --bg-hover: #243147;
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border-color: #263349;
      --accent-primary: #3b82f6;
      --accent-hover: #2563eb;
      --accent-soft: rgba(59, 130, 246, 0.14);
      --hod-color: #a855f7;
      --hod-soft: rgba(168, 85, 247, 0.14);
      --prof-color: #06b6d4;
      --prof-soft: rgba(6, 182, 212, 0.14);
      --student-color: #10b981;
      --student-soft: rgba(16, 185, 129, 0.14);
      --success: #10b981;
      --success-soft: rgba(16, 185, 129, 0.15);
      --warning: #f59e0b;
      --warning-soft: rgba(245, 158, 11, 0.15);
      --danger: #ef4444;
      --danger-soft: rgba(239, 68, 68, 0.15);
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 10px 25px rgba(0, 0, 0, 0.45);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="light"] {
      --bg-primary: #f1f5f9;
      --bg-secondary: #ffffff;
      --bg-card: #ffffff;
      --bg-input: #f8fafc;
      --bg-hover: #e2e8f0;
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --border-color: #cbd5e1;
      --accent-primary: #2563eb;
      --accent-hover: #1d4ed8;
      --accent-soft: rgba(37, 99, 235, 0.1);
      --hod-color: #9333ea;
      --hod-soft: rgba(147, 51, 234, 0.1);
      --prof-color: #0891b2;
      --prof-soft: rgba(8, 145, 178, 0.1);
      --student-color: #059669;
      --student-soft: rgba(5, 150, 105, 0.1);
      --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.06);
      --shadow-md: 0 10px 25px rgba(15, 23, 42, 0.1);
    }

    /* ==========================================================================
       2. RESET & BASE TYPOGRAPHY
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.55;
      min-height: 100vh;
      transition: background-color 0.25s ease, color 0.25s ease;
      overflow-x: hidden;
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: 0.95rem;
    }

    /* ==========================================================================
       3. UTILITY & LAYOUT COMPONENTS
       ========================================================================== */
    .hidden { display: none !important; }

    .container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 1.25rem;
    }

    /* Top Header Navigation */
    .topbar {
      background-color: var(--bg-secondary);
      border-bottom: 1px solid var(--border-color);
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 40;
      box-shadow: var(--shadow-sm);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--accent-primary), #6366f1);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.2rem;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35);
    }

    .brand-title h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand-title span {
      font-size: 0.78rem;
      color: var(--text-secondary);
      display: block;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.6rem 1.05rem;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
    }

    .btn:active { transform: scale(0.98); }

    .btn-primary {
      background-color: var(--accent-primary);
      color: #ffffff;
    }
    .btn-primary:hover { background-color: var(--accent-hover); }

    .btn-secondary {
      background-color: var(--bg-input);
      color: var(--text-primary);
      border-color: var(--border-color);
    }
    .btn-secondary:hover { background-color: var(--bg-hover); }

    .btn-danger {
      background-color: var(--danger-soft);
      color: var(--danger);
      border-color: rgba(239, 68, 68, 0.3);
    }
    .btn-danger:hover {
      background-color: var(--danger);
      color: #ffffff;
    }

    .btn-success {
      background-color: var(--success-soft);
      color: var(--success);
      border-color: rgba(16, 185, 129, 0.3);
    }
    .btn-success:hover {
      background-color: var(--success);
      color: #ffffff;
    }

    .btn-sm {
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
    }

    /* Cards & Grids */
    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.35rem;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1.15rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--border-color);
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    @media (max-width: 960px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
      .grid-3 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 680px) {
      .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
      .topbar { padding: 0.75rem 1rem; }
    }

    /* Form Controls */
    .form-group {
      margin-bottom: 1rem;
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 0.4rem;
    }

    .form-control {
      width: 100%;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background-color: var(--bg-input);
      color: var(--text-primary);
      outline: none;
      transition: var(--transition);
    }

    .form-control:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    textarea.form-control {
      min-height: 90px;
      resize: vertical;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.22rem 0.65rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .badge-hod { background: var(--hod-soft); color: var(--hod-color); }
    .badge-prof { background: var(--prof-soft); color: var(--prof-color); }
    .badge-student { background: var(--student-soft); color: var(--student-color); }
    .badge-success { background: var(--success-soft); color: var(--success); }
    .badge-warning { background: var(--warning-soft); color: var(--warning); }
    .badge-danger { background: var(--danger-soft); color: var(--danger); }

    /* Tables */
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }

    th {
      background-color: var(--bg-input);
      color: var(--text-secondary);
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.8rem 1rem;
      border-bottom: 1px solid var(--border-color);
      white-space: nowrap;
    }

    td {
      padding: 0.8rem 1rem;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    tr:last-child td { border-bottom: none; }
    tbody tr:hover { background-color: rgba(148, 163, 184, 0.04); }

    /* ==========================================================================
       4. LOGIN SCREEN STYLES
       ========================================================================== */
    .login-wrapper {
      min-height: calc(100vh - 72px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
    }

    .login-card {
      width: 100%;
      max-width: 480px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-md);
    }

    .role-selector {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      background-color: var(--bg-input);
      padding: 0.35rem;
      border-radius: var(--radius-sm);
      margin-bottom: 1.5rem;
      border: 1px solid var(--border-color);
    }

    .role-tab {
      padding: 0.6rem 0.5rem;
      border-radius: 6px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      transition: var(--transition);
    }

    .role-tab.active[data-role="hod"] {
      background-color: var(--hod-color);
      color: #fff;
    }
    .role-tab.active[data-role="professor"] {
      background-color: var(--prof-color);
      color: #fff;
    }
    .role-tab.active[data-role="student"] {
      background-color: var(--student-color);
      color: #fff;
    }

    .demo-box {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px dashed var(--border-color);
    }

    .demo-box-title {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 0.65rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .demo-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .demo-pill {
      flex: 1 1 auto;
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
      border-radius: 6px;
      background-color: var(--bg-input);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      cursor: pointer;
      transition: var(--transition);
      text-align: center;
    }

    .demo-pill:hover {
      border-color: var(--accent-primary);
      background-color: var(--accent-soft);
    }

    /* ==========================================================================
       5. DASHBOARD TABS & STATS
       ========================================================================== */
    .stat-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-info span {
      display: block;
      font-size: 0.8rem;
      color: var(--text-secondary);
      font-weight: 600;
    }

    .stat-info strong {
      font-size: 1.65rem;
      font-weight: 800;
      line-height: 1.2;
      margin-top: 0.2rem;
      display: block;
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }

    .nav-tabs {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.35rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }

    .nav-tab {
      padding: 0.65rem 1.1rem;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-secondary);
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: var(--transition);
    }

    .nav-tab:hover {
      background-color: var(--bg-input);
      color: var(--text-primary);
    }

    .nav-tab.active {
      background-color: var(--accent-soft);
      color: var(--accent-primary);
      border-color: rgba(59, 130, 246, 0.3);
    }

    /* Notice / Instruction Cards */
    .notice-item {
      padding: 1rem;
      border-radius: var(--radius-sm);
      background-color: var(--bg-input);
      border-left: 4px solid var(--hod-color);
      margin-bottom: 0.85rem;
    }

    .notice-item:last-child { margin-bottom: 0; }

    .notice-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }

    /* Student Profile Avatar */
    .profile-header {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .avatar-box {
      position: relative;
      width: 92px;
      height: 92px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid var(--student-color);
      background-color: var(--bg-input);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 800;
      color: var(--student-color);
      flex-shrink: 0;
    }

    .avatar-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ==========================================================================
       6. CUSTOM MODAL & TOAST NOTIFICATIONS (NO ALERT / CONFIRM)
       ========================================================================== */
    .toast-container {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-width: 360px;
    }

    .toast {
      padding: 0.85rem 1.1rem;
      border-radius: var(--radius-sm);
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-left: 4px solid var(--accent-primary);
      color: var(--text-primary);
      box-shadow: var(--shadow-md);
      font-size: 0.88rem;
      font-weight: 600;
      animation: slideIn 0.25s ease forwards;
    }

    .toast.success { border-left-color: var(--success); }
    .toast.error { border-left-color: var(--danger); }
    .toast.warning { border-left-color: var(--warning); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 100;
    }

    .modal-box {
      width: 100%;
      max-width: 480px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      box-shadow: var(--shadow-md);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.65rem;
      margin-top: 1.25rem;
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       TOP BAR HEADER (ALWAYS VISIBLE)
       ======================================================================== -->
  <header class="topbar">
    <div class="brand">
      <div class="brand-icon">NU</div>
      <div class="brand-title">
        <h1>NexusUni Academic Portal</h1>
        <span id="headerSubtitle">Department of Computer Engineering</span>
      </div>
    </div>

    <div class="topbar-actions">
      <span id="activeUserBadge" class="badge hidden"></span>
      <button type="button" id="themeToggleBtn" class="btn btn-secondary btn-sm" title="Switch Light/Dark Theme">
        <span id="themeIcon">☀️</span> <span id="themeText">Light Mode</span>
      </button>
      <button type="button" id="logoutBtn" class="btn btn-danger btn-sm hidden">
        Logout
      </button>
    </div>
  </header>

  <!-- ========================================================================
       1. AUTHENTICATION / LOGIN VIEW (3 ROLES)
       ======================================================================== -->
  <main id="loginView" class="login-wrapper">
    <div class="login-card">
      <div style="text-align: center; margin-bottom: 1.35rem;">
        <h2 style="font-size: 1.45rem; font-weight: 800;">Portal Sign In</h2>
        <p style="color: var(--text-secondary); font-size: 0.88rem; margin-top: 0.25rem;">
          Select your institutional role to access your dashboard
        </p>
      </div>

      <!-- 3-Role Switcher Tabs -->
      <div class="role-selector" role="tablist">
        <button type="button" class="role-tab active" data-role="hod">HOD Login</button>
        <button type="button" class="role-tab" data-role="professor">Professor</button>
        <button type="button" class="role-tab" data-role="student">Student</button>
      </div>

      <!-- Login Form -->
      <form id="loginForm">
        <div class="form-group">
          <label id="loginIdLabel" class="form-label" for="loginIdentifier">HOD Official Email</label>
          <input
            type="email"
            id="loginIdentifier"
            class="form-control"
            placeholder="hod.ce@nexusuni.edu"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="loginPassword">Password</label>
          <input
            type="password"
            id="loginPassword"
            class="form-control"
            placeholder="Enter your password"
            required
          />
        </div>

        <button type="submit" id="loginSubmitBtn" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">
          Sign In as HOD
        </button>
      </form>

      <!-- Quick Demo Autofill Section -->
      <div class="demo-box">
        <div class="demo-box-title">
          <span>Quick Demo Autofill</span>
          <button type="button" id="resetDemoBtn" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.72rem;">
            Reset Demo Data
          </button>
        </div>
        <div class="demo-pills">
          <button type="button" class="demo-pill" onclick="fillDemoLogin('hod')">
            <strong>HOD</strong><br/><span style="color: var(--text-secondary);">Dr. R. K. Sharma</span>
          </button>
          <button type="button" class="demo-pill" onclick="fillDemoLogin('professor')">
            <strong>Professor</strong><br/><span style="color: var(--text-secondary);">Prof. Ananya Verma</span>
          </button>
          <button type="button" class="demo-pill" onclick="fillDemoLogin('student')">
            <strong>Student</strong><br/><span style="color: var(--text-secondary);">240140107001</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- ========================================================================
       2. HOD DASHBOARD VIEW (FULL SYSTEM & FACULTY CONTROL)
       ======================================================================== -->
  <section id="hodDashboard" class="container hidden">
    <!-- Top KPIs -->
    <div class="grid-4" style="margin-bottom: 1.5rem;" id="hodStatsGrid"></div>

    <!-- Navigation Tabs -->
    <div class="nav-tabs" id="hodNavTabs">
      <button type="button" class="nav-tab active" data-tab="hod-instructions">Instructions & Notices</button>
      <button type="button" class="nav-tab" data-tab="hod-professors">Manage Professors</button>
      <button type="button" class="nav-tab" data-tab="hod-students">All Students & Results</button>
      <button type="button" class="nav-tab" data-tab="hod-tickets">Student Requests & Feedback</button>
    </div>

    <!-- Tab 1: Instructions -->
    <div id="hod-instructions" class="hod-tab-panel">
      <div class="grid-2">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Broadcast Official Instruction</h3>
          </div>
          <form id="hodInstructionForm">
            <div class="form-group">
              <label class="form-label">Instruction Title</label>
              <input type="text" id="instTitle" class="form-control" placeholder="e.g., Mid-Semester Exam Schedule & Guidelines" required />
            </div>
            <div class="form-group">
              <label class="form-label">Target Audience</label>
              <select id="instAudience" class="form-control">
                <option value="All (Professors & Students)">All (Professors & Students)</option>
                <option value="Professors Only">Professors Only</option>
                <option value="Students Only">Students Only</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Detailed Directive</label>
              <textarea id="instBody" class="form-control" placeholder="Write clear academic instructions..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Publish Instruction</button>
          </form>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Active Department Instructions</h3>
          </div>
          <div id="hodInstructionsList"></div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Manage Professors -->
    <div id="hod-professors" class="hod-tab-panel hidden">
      <div class="grid-2">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Add New Professor</h3>
          </div>
          <form id="addProfForm">
