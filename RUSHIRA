    /* ------------------------------------------------------------------------
       CALCULATION HELPERS (PASSING = 12 / 30)
       ------------------------------------------------------------------------ */
    function getEffectiveScore(markRecord) {
      if (markRecord.remid !== null && markRecord.remid !== undefined && markRecord.remid !== "") {
        return Math.max(Number(markRecord.mid), Number(markRecord.remid));
      }
      return Number(markRecord.mid);
    }

    function getStudentAverages(enrollment) {
      const records = appState.marks.filter(m => m.enrollment === enrollment);
      if (records.length === 0) return { midPct: "N/A", finalPct: "N/A", passed: true };

      const midSum = records.reduce((acc, r) => acc + Number(r.mid), 0);
      const finalSum = records.reduce((acc, r) => acc + getEffectiveScore(r), 0);
      const maxTotal = records.length * 30;

      const midPct = ((midSum / maxTotal) * 100).toFixed(1) + "%";
      const finalPct = ((finalSum / maxTotal) * 100).toFixed(1) + "%";
      const passed = records.every(r => getEffectiveScore(r) >= 12);

      return { midPct, finalPct, passed };
    }

